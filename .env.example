# ============================================================
# Mining Dispatch — Configuracion de la aplicacion de escritorio
# Copia este archivo a .env y ajusta los valores si hace falta.
# Todas las variables son opcionales: la app abre sin .env.
# ============================================================

# --- Rutas ---
MODEL_PATH=models/best.pt
DB_URL=sqlite:///data/eventos.db
VIDEO_PATH=

# --- Camara ---
# Indice de webcam (0, 1, ...) o URL RTSP/HTTP.
#   CAMERA_SOURCE=0
#   CAMERA_SOURCE=http://192.168.1.50:4747/video
#   CAMERA_SOURCE=rtsp://usuario:clave@ip:554/stream
CAMERA_SOURCE=0

# --- Deteccion ---
CONFIDENCE_THRESHOLD=0.5

# --- Rendimiento del pipeline (CPU) ---
TRACK_SKIP=3
TRACK_IMGSZ=320
FRAMES_AUSENCIA=90
FLUSH_EVERY_FRAMES=60
FORZAR_CPU=false

# --- Modulos opcionales ---
OCR_HABILITADO=false
CLASIFICADOR_HABILITADO=false

# --- Interfaz ---
DISPLAY_WIDTH=960
WINDOW_GEOMETRY=1280x780

# --- Análisis batch (procesamiento offline) ---
# Carpeta de videos cargados (copia local del usuario).
VIDEOS_DIR=data/videos
# Carpeta de videos anotados (salida del análisis).
OUTPUT_DIR=data/output
# Carpeta de reportes PDF y Excel.
REPORTS_DIR=data/reports
# Máximo de trabajos procesándose simultáneamente (1 = sin paralelismo).
MAX_JOBS_SIMULTANEOS=1
