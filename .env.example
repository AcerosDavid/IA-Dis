# ============================================================
# Mining Dispatch MVP — Configuracion de entorno
# Copia este archivo a .env y completa los valores
# ============================================================

# --- Rutas obligatorias ---

# Ruta al video de prueba local (.mp4, .avi, .mov)
VIDEO_PATH=data/raw/video.mp4

# Ruta al modelo YOLO26
# Placeholder:  models/yolo26n.pt  (se descarga automatico la primera vez)
# Entrenado:    models/best.pt     (generado con python train.py)
MODEL_PATH=models/best.pt

# Ruta al archivo de base de datos SQLite
DB_PATH=data/eventos.db

# --- Camara en tiempo real (DroidCam) ---

# URL del stream DroidCam desde el celular (puerto por defecto: 4747)
# 1. Instala DroidCam en tu Android/iPhone
# 2. Conecta el celular y la PC a la misma red WiFi
# 3. Abre DroidCam y anota la IP que muestra la app
# 4. Reemplaza la IP en la URL de abajo
# Formato: http://<IP-del-celular>:4747/video
CAMERA_SOURCE=http://192.168.1.X:4747/video

# Otras fuentes soportadas:
#   Webcam local:        CAMERA_SOURCE=0
#   Camara RTSP:         CAMERA_SOURCE=rtsp://usuario:clave@ip:554/stream

# --- Parametros opcionales ---

# Umbral de confianza minimo para registrar una deteccion (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5

# Host y puerto de la API FastAPI
API_HOST=127.0.0.1
API_PORT=8000