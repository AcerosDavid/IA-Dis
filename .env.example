# ============================================================
# Mining Dispatch — Configuracion de la aplicacion de escritorio
# Copia este archivo a .env y ajusta los valores si hace falta.
# Todas las variables son opcionales: la app abre sin .env.
# ============================================================

# --- Rutas ---

# Modelo YOLO (.pt). Por defecto se usa el modelo entrenado.
MODEL_PATH=models/best.pt

# Base de datos local SQLite.
DB_URL=sqlite:///data/eventos.db

# Video sugerido al abrir la app (puede quedar vacio).
VIDEO_PATH=

# --- Camara ---

# Indice de webcam (0, 1, ...) o URL RTSP/HTTP.
# Ejemplos:
#   CAMERA_SOURCE=0
#   CAMERA_SOURCE=http://192.168.1.50:4747/video
#   CAMERA_SOURCE=rtsp://usuario:clave@ip:554/stream
CAMERA_SOURCE=0

# --- Deteccion ---

# Umbral de confianza minimo (0.0 - 1.0).
CONFIDENCE_THRESHOLD=0.5

# --- Rendimiento del pipeline (CPU) ---

# Procesar 1 de cada N frames (1 = todos, 3 = recomendado en CPU).
TRACK_SKIP=3
# Resolucion de inferencia (320 es el optimo en CPU).
TRACK_IMGSZ=320
# Frames sin ver un track para emitir "desaparicion".
FRAMES_AUSENCIA=90
# Cada cuantos frames procesados se hace COMMIT en la base de datos.
FLUSH_EVERY_FRAMES=60

# --- Modulos opcionales ---

# OCR de numeros de flota (requiere easyocr).
OCR_HABILITADO=false
# Clasificador de estado LSTM/CNN (requiere modelos entrenados).
CLASIFICADOR_HABILITADO=false

# --- Interfaz ---

# Ancho maximo del frame mostrado (0 = sin escalar).
DISPLAY_WIDTH=960
# Tamano inicial de la ventana.
WINDOW_GEOMETRY=1180x760
