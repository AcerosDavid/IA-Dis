# ────────────────────────────────────────────────────────────────
# .env.docker — Variables para el contenedor Docker
# Copia este archivo al servidor como .env.docker y ajusta valores
# ────────────────────────────────────────────────────────────────

# Rutas dentro del contenedor (no cambiar salvo que edites compose)
DB_URL=sqlite:////app/data/eventos.db
MODEL_PATH=/app/models/best.pt

# API
API_HOST=0.0.0.0
API_PORT=8000

# Umbral de confianza YOLO (0.0–1.0)
CONFIDENCE_THRESHOLD=0.5

# VIDEO_PATH y CAMERA_SOURCE solo son necesarios para main.py/camera.py
# En Docker solo se usa la API, así que se dejan como placeholder
VIDEO_PATH=/app/data/raw/video.mp4
CAMERA_SOURCE=0
